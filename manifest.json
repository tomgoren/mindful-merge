{
  "manifest_version": 3,
  "name": "Mindful Merge",
  "version": "1.3.0",
  "description": "Warns reviewers before approving a GitHub pull request with auto-merge enabled.",
  "icons": {
    "16": "icons/mindful-merge-16.png",
    "32": "icons/mindful-merge-32.png",
    "48": "icons/mindful-merge-48.png",
    "128": "icons/mindful-merge-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
